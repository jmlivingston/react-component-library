{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Component name in PascalCase",
      "pattern": "^[A-Z][a-zA-Z0-9]*$",
      "x-prompt": "Component name (PascalCase):"
    }
  },
  "required": ["name"]
}
