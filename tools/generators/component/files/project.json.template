{
  "name": "<%= propertyName %>",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/<%= className %>/src",
  "projectType": "library",
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --write \"**/*.{js,jsx,mjs,json,md,scss}\"",
        "cwd": "packages/<%= className %>"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project @react-component-library/<%= fileName %>"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --cache --cache-location node_modules/.cache/eslint/ packages/<%= className %>"
      }
    }
  }
}