{
  "name": "{{camelCase name}}",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/{{pascalCase name}}/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/lib"],
      "options": {
        "command": "vite build",
        "cwd": "packages/{{pascalCase name}}"
      }
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "configDir": "packages/{{pascalCase name}}/.storybook",
        "port": 6006
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "{projectRoot}/lib"
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}/lib"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
