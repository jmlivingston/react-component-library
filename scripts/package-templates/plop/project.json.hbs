{
  "name": "{{camelCase name}}",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/{{pascalCase name}}/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project @react-component-library/{{kebabCase name}}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint --cache --cache-location node_modules/.cache/eslint/ packages/{{pascalCase name}}"
      }
    }
  }
}
