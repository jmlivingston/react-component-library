{
  "name": "react-component-library",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "packageManager": "yarn@1.22.0",
  "scripts": {
    "prepare": "lefthook install",
    "storybook": "node scripts/storybook",
    "build": "node scripts/build",
    "lint": "node scripts/lint",
    "lint-watch": "node scripts/lint --watch",
    "lint:styles": "node scripts/stylelint",
    "lint-watch:styles": "node scripts/stylelint --watch",
    "test": "node scripts/test",
    "test-watch": "node scripts/test --watch",
    "format": "prettier --write \"**/*.{js,json,md,scss}\"",
    "clear-cache": "nx reset",
    "clear-build": "rm -rf packages/*/lib",
    "create-package": "plop --plopfile scripts/package-templates/plopfile.js",
    "link-all": "node scripts/link.js link",
    "unlink-all": "node scripts/link.js unlink",
    "sync-peer-deps": "node scripts/syncPeerDeps.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.8.0",
    "@nx/react": "^21.6.3",
    "@nx/storybook": "^21.6.3",
    "@nx/vite": "21.6.3",
    "@storybook/addon-docs": "9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/react-vite": "9.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@viking-eng/config": "^2.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.12.0",
    "inquirer": "^12.9.6",
    "jsdom": "^26.1.0",
    "lefthook": "^1.13.6",
    "nx": "21.6.3",
    "plop": "^4.0.4",
    "prettier": "^2.6.2",
    "pretty-quick": "^4.2.2",
    "sass-embedded": "^1.93.2",
    "storybook": "9.1.10",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-scss": "^6.12.1",
    "vite": "^7.1.9",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "prettier": "./node_modules/@viking-eng/config/prettier",
  "eslintConfig": {
    "extends": "./node_modules/@viking-eng/config/eslint-config-react",
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "parserOptions": {
      "requireConfigFile": false,
      "babelOptions": {
        "presets": [
          "@babel/preset-react"
        ]
      }
    },
    "rules": {
      "react/prop-types": "off",
      "react/react-in-jsx-scope": "off"
    },
    "overrides": [
      {
        "files": [
          "scripts/**/*.js",
          "scripts/**/*.mjs",
          "packages/**/.storybook/**/*.mjs"
        ],
        "rules": {
          "import/extensions": [
            "error",
            "always",
            {
              "ignorePackages": true
            }
          ],
          "import/no-extraneous-dependencies": [
            "error",
            {
              "devDependencies": true
            }
          ]
        }
      },
      {
        "files": [
          "packages/*/src/**/*.{js,jsx}"
        ],
        "rules": {
          "import/no-unresolved": [
            "error",
            {
              "ignore": [
                "^@react-component-library/"
              ]
            }
          ],
          "import/extensions": "off",
          "react/function-component-definition": "off"
        }
      },
      {
        "files": [
          "packages/*/src/**/*.test.{js,jsx}",
          "packages/*/src/**/*.stories.{js,jsx}"
        ],
        "rules": {
          "import/no-extraneous-dependencies": "off"
        }
      }
    ]
  }
}
